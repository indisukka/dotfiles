{
  "telemetry.telemetryLevel": "crash",
  "workbench.iconTheme": "material-icon-theme",
  "editor.fontFamily": "'lilex','monolisa',monospace,'FontAwesome', 'symbols nerd font mono'",
  "editor.fontSize": 14,
  "editor.fontLigatures": true,
  "editor.lineHeight": 1.8,
  "editor.fontWeight": "400",
  "editor.mouseWheelZoom": true,
  "editor.minimap.enabled": false,
  "terminal.integrated.cursorStyle": "underline",
  "terminal.integrated.fontFamily": "'JetBrains Mono', monospace,'symbols nerd font mono'",
  "terminal.integrated.fontSize": 11,
  "terminal.integrated.fontWeight": "normal",
  // "terminal.integrated.lineHeight": 1.0,
  "terminal.integrated.defaultProfile.linux": "fish",
  "window.zoomLevel": 0.8,
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[shellscript]": {
    "editor.defaultFormatter": "mkhl.shfmt",
  },
  "[javascript]": {
    // "editor.defaultFormatter": "vscode.typescript-language-features"
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "terminal.integrated.profiles.linux": {
    "fish": {
      "path": "fish",
    },
    "bash": {
      "path": "bash",
      "icon": "terminal-bash",
    },
  },
  "github.copilot.nextEditSuggestions.enabled": false,
  "github.copilot.nextEditSuggestions.eagerness": "low",
  "markdown.extension.tableFormatter.enabled": false,
  "workbench.colorTheme": "Base16 Tomorrow Dark",
  "base16.generator.activatedThemes": [
    "base16-default-dark",
    "base16-tomorrow-night-dark",
  ],
  "redhat.telemetry.enabled": false,
}
